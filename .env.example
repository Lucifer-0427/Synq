# Copy this file to ".env" (same folder as server.js) and fill in your key.
# Get a free key from Google Cloud Console:
#   1. https://console.cloud.google.com/apis/library/youtube.googleapis.com
#   2. Create a project (or pick an existing one) and click "Enable"
#   3. Go to "Credentials" -> "Create Credentials" -> "API key"
#   4. Paste the key below
#
# Free tier gives 10,000 quota units/day — each search costs 100 units
# (~100 searches/day), which is plenty for personal use.

YOUTUBE_API_KEY=

# Required for accounts (sign up / log in) to work at all — this signs the
# login session cookie. Any long random string is fine; it just needs to
# stay the same across restarts/deploys, or everyone gets logged out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional — only needed on Vercel (or anywhere the filesystem isn't
# writable/persistent). Added automatically when you connect the Upstash
# Redis integration from the Vercel Marketplace. Without it, accounts and
# playlists are stored in a local db.local.json file, which works fine for
# `npm start` on your own machine but won't survive a Vercel redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
